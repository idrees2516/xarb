# XARB — Rust core deployment
# Copy to .env and fill in. NEVER commit the real .env.

# ── mode ────────────────────────────────────────────────────────────────────
# paper = simulated fills against the live book (default, zero risk)
# live  = real EIP-712 signed orders on Polymarket CLOB (Polygon 137)
XARB_MODE=paper
XARB_PORT=3002

# ── strategy thresholds (defaults shown) ───────────────────────────────────
XARB_STAKE_USD=25
XARB_JUMP_C=20          # ① 5s FV jump ≥ 20¢
XARB_FLOOR_C=60         # ② FV > 60¢
XARB_EDGE_C=10          # ③ PM ask ≥ 10¢ below FV
XARB_MIN_SECS=45
XARB_MAX_TRADES=1
XARB_MODEL=cdf          # cdf (normal-cdf, calibrated) | linear (legacy)
XARB_AUTO_TRADE=1
XARB_TAKER_FEE_BPS=0
XARB_NEG_RISK=0         # set 1 if the market resolves via the neg-risk exchange

# ── LIVE MODE ONLY ──────────────────────────────────────────────────────────
# EOA private key (secp256k1, 32-byte hex) that holds USDC on Polygon and
# has an Polymarket allowance set for the CTF Exchange.
POLY_PRIVATE_KEY=
# Optional explicit CLOB API creds (auto-derived from the key if omitted):
# POLY_API_KEY=
# POLY_SECRET=
# POLY_PASSPHRASE=
# Mandatory safety gate — real money moves when this is set:
XARB_LIVE_CONFIRM=I_UNDERSTAND_THE_RISK
